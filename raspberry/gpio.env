# Réglages du Raspberry : sirène et lampe (relais) + débit vidéo.
# Copié dans /etc/previa/gpio.env par installer_raspberry.sh (jamais
# écrasé s'il existe déjà). Après modification :
#     sudo systemctl restart previa-api
#
# Numéros de broches en numérotation BCM (pas le numéro physique 1-40) :
#     BCM17 = broche physique 11, BCM27 = broche physique 13
PREVIA_GPIO_LAMPE=17
PREVIA_GPIO_SIRENE=27

# 1 = le relais s'active quand la broche passe à 0 V (la plupart des cartes
#     relais à optocoupleur). 0 = il s'active à 3,3 V.
# Si au branchement la sirène sonne au repos et se tait pendant l'alerte :
# mettez l'autre valeur.
PREVIA_RELAIS_ACTIF_BAS=1

# Décommenter pour forcer la simulation (aucun relais piloté) :
# PREVIA_GPIO=off

# Débit vidéo : nombre maximum d'images par seconde traitées pour CHAQUE caméra.
# 15 suffit largement pour la surveillance et divise la charge du processeur
# (important sur Raspberry Pi 4 avec 3 caméras). 0 ou vide = pas de limite.
PREVIA_VIDEO_FPS=15
